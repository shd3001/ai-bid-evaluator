# Docker 部署所需变量。复制为 .env（已有 .env 则跳过，compose 会自动读取）。
# 敏感值不要提交到版本库；.gitignore 已排除 .env。

DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_DOC_MODEL=qwen-long-2025-01-25
BAILIAN_AGENT_MODEL=qwen3.7-plus

# 机会发现链的搜索源；只用 ccgp 时留空 SEARCH_API_KEY 并把 SEARCH_PROVIDERS 改成 ccgp。
SEARCH_API_KEY=
SEARCH_API_BASE=https://api.bochaai.com
SEARCH_PROVIDERS=bocha,ccgp
MAX_CANDIDATES=5

# 模型重试次数，失败重试都会真实计费，部署后建议保持默认或调小。
BAILIAN_RETRY_COUNT=5
BAILIAN_RETRY_SECONDS=8

# 检查点是否自动确认；AUTO_YES=1 只保存检查点，不会自动确认资格/规则/推荐。
AUTO_YES=0

# DATABASE_URL、LOG_FORMAT、CORS_ORIGINS 由 docker-compose.yml 固定，无需在此设置。